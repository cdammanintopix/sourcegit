<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.DependenciesView">
  <UserControl.DataTemplates>
    <!-- Shared tooltip, used by both the tree and the flat list below. -->
    <DataTemplate DataType="m:Dependency">
      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
          <Path Width="10" Height="10" Data="{StaticResource Icons.Link}"/>
          <TextBlock FontWeight="Bold" Margin="6,0,0,0" Text="{Binding Name}"/>
        </StackPanel>

        <!-- The `CHECKED OUT` row is only shown on a mismatch, so it must collapse when hidden. -->
        <Grid RowDefinitions="24,Auto,24,24" ColumnDefinitions="Auto,Auto" Margin="0,8,0,0">
          <TextBlock Grid.Row="0" Grid.Column="0"
                     Classes="info_label"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Text="{DynamicResource Text.Dependency.Revision}"/>
          <StackPanel Grid.Row="0" Grid.Column="1"
                      Orientation="Horizontal"
                      Margin="8,0,0,0">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Commit}"/>

            <TextBlock Margin="8,0,0,0"
                       Text="{Binding RevHash, Converter={x:Static c:StringConverters.ToShortSHA}}"
                       FontFamily="{DynamicResource Fonts.Monospace}"
                       VerticalAlignment="Center"/>

            <Path Margin="6,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Width="12" Height="12"
                  Data="{StaticResource Icons.Check}"
                  Fill="Green"
                  IsVisible="{Binding IsClean}"/>
            <Border Height="16"
                    Margin="6,0,0,0" Padding="4,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="DarkOrange"
                    CornerRadius="4"
                    IsVisible="{Binding HasStatusBadge}">
              <Grid>
                <TextBlock VerticalAlignment="Center"
                           Text="{DynamicResource Text.Dependency.Status.NotCloned}"
                           Foreground="White"
                           IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:DependencyStatus.NotCloned}}"/>
                <TextBlock VerticalAlignment="Center"
                           Text="{DynamicResource Text.Submodule.Status.RevisionChanged}"
                           Foreground="White"
                           IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:DependencyStatus.RevisionChanged}}"/>
                <TextBlock VerticalAlignment="Center"
                           Text="{DynamicResource Text.Dependency.Status.Unsupported}"
                           Foreground="White"
                           IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:DependencyStatus.Unsupported}}"/>
              </Grid>
            </Border>

            <!-- Orthogonal to the status above: a dependency can sit on the wrong revision AND be modified. -->
            <Border Height="16"
                    Margin="6,0,0,0" Padding="4,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="DarkOrange"
                    CornerRadius="4"
                    IsVisible="{Binding HasLocalChanges}">
              <TextBlock VerticalAlignment="Center"
                         Text="{DynamicResource Text.Submodule.Status.Modified}"
                         Foreground="White"/>
            </Border>
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0"
                     Classes="info_label"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Text="{DynamicResource Text.Dependency.CheckedOut}"
                     IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:DependencyStatus.RevisionChanged}}"/>
          <StackPanel Grid.Row="1" Grid.Column="1"
                      Orientation="Horizontal"
                      Height="24"
                      Margin="8,0,0,0"
                      IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:DependencyStatus.RevisionChanged}}">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Commit}"/>

            <TextBlock Margin="8,0,0,0"
                       Text="{Binding HeadSHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                       FontFamily="{DynamicResource Fonts.Monospace}"
                       VerticalAlignment="Center"/>

            <Path Width="14" Height="14"
                  Margin="8,0,0,0"
                  Data="{StaticResource Icons.Branch}"
                  IsVisible="{Binding HeadBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Margin="6,0,0,0"
                       Text="{Binding HeadBranch}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HeadBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0"
                     Classes="info_label"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Text="{DynamicResource Text.Dependency.Date}"/>
          <TextBlock Grid.Row="2" Grid.Column="1"
                     Margin="8,0,0,0"
                     Text="{Binding RevDate}"
                     VerticalAlignment="Center"/>

          <TextBlock Grid.Row="3" Grid.Column="0"
                     Classes="info_label"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Text="{DynamicResource Text.Submodule.URL}"/>
          <TextBlock Grid.Row="3" Grid.Column="1"
                     Margin="8,0,0,0"
                     Text="{Binding URL}"
                     Foreground="{DynamicResource Brush.Link}"
                     VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:DependencyCollectionAsTree">
      <ListBox Classes="repo_left_content_list" Padding="0,0,2,0" ItemsSource="{Binding Rows}" SelectionMode="Single" KeyDown="OnKeyDown">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:DependencyTreeNode">
            <Border Height="24"
                    Background="Transparent"
                    DoubleTapped="OnItemDoubleTapped"
                    ContextRequested="OnItemContextRequested"
                    ToolTip.Tip="{Binding Dependency}"
                    ToolTip.Placement="Right">
              <Grid ColumnDefinitions="16,Auto,*,Auto,Auto"
                    Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}"
                    VerticalAlignment="Center">
                <v:DependencyTreeNodeToggleButton Grid.Column="0"
                                                  Classes="tree_expander"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                  IsVisible="{Binding IsFolder}"/>

                <v:DependencyTreeNodeIcon Grid.Column="1"
                                          IsExpanded="{Binding IsExpanded, Mode=OneWay}"/>

                <TextBlock Grid.Column="2"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding FullPath, Converter={x:Static c:PathConverters.PureFileName}, Mode=OneWay}"/>
                  <Run Text="{Binding ChildCounter}" Foreground="{DynamicResource Brush.FG2}"/>
                </TextBlock>

                <Path Grid.Column="3"
                      Width="8" Height="8"
                      Margin="0,0,8,0"
                      Fill="Goldenrod"
                      Data="{StaticResource Icons.Modified}"
                      IsVisible="{Binding IsDirty}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DataTemplate>

    <DataTemplate DataType="vm:DependencyCollectionAsList">
      <ListBox Classes="repo_left_content_list" ItemsSource="{Binding Dependencies}" SelectionMode="Single" KeyDown="OnKeyDown">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:Dependency">
            <Border Height="24"
                    Background="Transparent"
                    DoubleTapped="OnItemDoubleTapped"
                    ContextRequested="OnItemContextRequested"
                    ToolTip.Tip="{Binding}"
                    ToolTip.Placement="Right">
              <Grid ColumnDefinitions="16,*,Auto" Margin="8,0,0,0" VerticalAlignment="Center">
                <Path Grid.Column="0" Width="10" Height="10" Margin="8,0" Data="{StaticResource Icons.Link}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" ClipToBounds="True" TextTrimming="CharacterEllipsis"/>
                <Path Grid.Column="2"
                      Width="8" Height="8"
                      Margin="8,0,8,0"
                      Fill="Goldenrod"
                      Data="{StaticResource Icons.Modified}"
                      IsVisible="{Binding IsDirty}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
